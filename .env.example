# Copy this file to .env in the root of your own presentation project.
# Never place secrets in the installed site-packages directory or commit .env.

# Preferred explicit configuration for generated images:
PPT_IMAGE_LLM_PROVIDER=gpt-image
OPENAI_API_KEY=replace-with-your-api-key
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Or use one supported provider instead:
# PPT_IMAGE_LLM_PROVIDER=seedream
# ARK_API_KEY=                         # ByteDance Seedream
# ARK_IMAGE_MODEL=

# PPT_IMAGE_LLM_PROVIDER=gemini
# GEMINI_API_KEY=                      # Google Gemini image models
# GEMINI_IMAGE_MODEL=

# PPT_IMAGE_LLM_PROVIDER=wanx
# DASHSCOPE_API_KEY=                   # Alibaba Wanx
# DASHSCOPE_IMAGE_MODEL=

# Generic OpenAI-compatible endpoint (set the provider as well):
# PPT_IMAGE_LLM_PROVIDER=gpt-image
# PPT_IMAGE_LLM_API_KEY=
# PPT_IMAGE_LLM_BASE_URL=
# PPT_IMAGE_LLM_MODEL=

# UNSPLASH_ACCESS_KEY=                 # stock-photo search
# PEXELS_API_KEY=                      # stock-photo search
